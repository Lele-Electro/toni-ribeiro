# Copy to .env (ignored by Git) for local development, or set the variable in the
# hosting platform's environment for production. Never commit a real key.
#
# Browser key for the booking form's pickup and drop-off address search.
# Restrict it in Google Cloud Console to:
#   APIs:      Maps JavaScript API, Places API (New)
#   Referrers: http://localhost:4200/*, http://localhost:4000/*,
#              https://www.toniribeiro.com/*, https://toniribeiro.com/*
# Without a key the form still works: members type the address by hand.
GOOGLE_MAPS_API_KEY=replace-with-your-restricted-browser-key
